# ==========================================
# CineBook Environment Variables Example
# ==========================================

# Google Gemini AI API Key (Server-Side Only)
# Obtain your key at: https://aistudio.google.com/app/apikey
# Add your key to .env.local or your hosting provider's environment variables.
# Never commit real API keys to version control.
GEMINI_API_KEY=your_gemini_api_key_here

# Application URL for QR Code Verification
# Set VITE_APP_URL to your publicly accessible HTTPS deployment URL so that
# mobile phone camera QR scans route to the live ticket verification page.
VITE_APP_URL=https://ais-pre-2l5nugll5rgum3y4yrhvtd-126430505601.asia-east1.run.app

# Server Port (Default: 3000)
PORT=3000

